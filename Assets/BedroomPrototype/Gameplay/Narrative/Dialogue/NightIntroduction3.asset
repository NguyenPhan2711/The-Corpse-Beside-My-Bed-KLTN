    pauseForAnimation: 0
    hideDuringEvent: 0
    condition:
      day: 0
      night: 0
      requiredFlag: 
      flagValue: 1
      choiceSource: 
      choiceEntry: 
      choiceReply: 
    choices: []
  - speaker: TheTruth
    text: Although...
    localizedText:
      m_TableReference:
        m_TableCollectionName: GUID:307a777c1a3e2004bbee95f62ad7e4f4
      m_TableEntryReference:
        m_KeyId: 2054317092870
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    charactersPerSecond: -1
    eventId: 
