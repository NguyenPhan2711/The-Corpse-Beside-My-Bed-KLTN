  lines:
  - speaker: TheTruth
    text: Well.
    charactersPerSecond: -1
    eventId: 
    eventAfterLine: 1
    pauseForAnimation: 0
    hideDuringEvent: 0
    condition:
      day: 0
      night: 0
      requiredFlag: 
      flagValue: 1
      choiceSource: 
      choiceEntry: 
      choiceReply: 
    choices: []
  - speaker: TheTruth
    text: Would you look at that.
    charactersPerSecond: -1
    eventId: 
    eventAfterLine: 1
    pauseForAnimation: 0
    hideDuringEvent: 0
    condition:
      day: 0
      night: 0
      requiredFlag: 
      flagValue: 1
      choiceSource: 
      choiceEntry: 
      choiceReply: 
    choices: []
  - speaker: TheTruth
    text: He's been beside you this whole time.
    charactersPerSecond: -1
    eventId: 
    eventAfterLine: 1
    pauseForAnimation: 0
    hideDuringEvent: 0
    condition:
      day: 0
      night: 0
      requiredFlag: 
      flagValue: 1
      choiceSource: 
      choiceEntry: 
      choiceReply: 
    choices: []
  - speaker: TheTruth
    text: Even I thought you'd recognize him sooner.
    charactersPerSecond: -1
    eventId: glass.fracture
    eventAfterLine: 1
    pauseForAnimation: 1
    hideDuringEvent: 0
    condition:
      day: 0
      night: 0
      requiredFlag: 
      flagValue: 1
      choiceSource: 
      choiceEntry: 
      choiceReply: 
    choices: []
  - speaker: TheTruth
    text: Doesn't he look familiar?
    charactersPerSecond: -1
    eventId: glass.reveal
    eventAfterLine: 1
    pauseForAnimation: 1
    hideDuringEvent: 1
    condition:
      day: 0
      night: 0
      requiredFlag: 
      flagValue: 1
      choiceSource: 
      choiceEntry: 
      choiceReply: 
    choices: []
  - speaker: TheTruth
    text: Don't look so surprised.
    charactersPerSecond: -1
    eventId: 
    eventAfterLine: 1
    pauseForAnimation: 0
    hideDuringEvent: 0
    condition:
      day: 0
      night: 0
      requiredFlag: 
      flagValue: 1
      choiceSource: 
      choiceEntry: 
      choiceReply: 
    choices: []
  - speaker: TheTruth
    text: You've spent so much time thinking about becoming him.
    charactersPerSecond: -1
    eventId: 
    eventAfterLine: 1
    pauseForAnimation: 0
    hideDuringEvent: 0
    condition:
      day: 0
      night: 0
      requiredFlag: 
      flagValue: 1
      choiceSource: 
      choiceEntry: 
      choiceReply: 
    choices: []
  - speaker: TheTruth
    text: Here's the thing.
    charactersPerSecond: -1
    eventId: 
    eventAfterLine: 1
    pauseForAnimation: 0
    hideDuringEvent: 0
    condition:
      day: 0
      night: 0
      requiredFlag: 
      flagValue: 1
      choiceSource: 
      choiceEntry: 
      choiceReply: 
    choices: []
  - speaker: TheTruth
    text: He doesn't want to be alone anymore.
    charactersPerSecond: -1
    eventId: 
    eventAfterLine: 1
    pauseForAnimation: 0
    hideDuringEvent: 0
    condition:
      day: 0
      night: 0
      requiredFlag: 
      flagValue: 1
      choiceSource: 
      choiceEntry: 
      choiceReply: 
    choices: []
  - speaker: TheTruth
    text: If you feel yourself sinking toward him...
    charactersPerSecond: -1
    eventId: 
    eventAfterLine: 1
    pauseForAnimation: 0
    hideDuringEvent: 0
    condition:
      day: 0
      night: 0
      requiredFlag: 
      flagValue: 1
      choiceSource: 
      choiceEntry: 
      choiceReply: 
    choices: []
  - speaker: TheTruth
    text: Look at him.
    charactersPerSecond: -1
    eventId: 
    eventAfterLine: 1
    pauseForAnimation: 0
    hideDuringEvent: 0
    condition:
      day: 0
      night: 0
      requiredFlag: 
      flagValue: 1
      choiceSource: 
      choiceEntry: 
      choiceReply: 
    choices: []
  - speaker: TheTruth
    text: Push yourself back up.
    charactersPerSecond: -1
    eventId: 
    eventAfterLine: 1
    pauseForAnimation: 0
    hideDuringEvent: 0
    condition:
      day: 0
      night: 0
      requiredFlag: 
      flagValue: 1
      choiceSource: 
      choiceEntry: 
      choiceReply: 
    choices: []
  - speaker: TheTruth
    text: Don't let him pull you down.
    charactersPerSecond: -1
    eventId: 
    eventAfterLine: 1
    pauseForAnimation: 0
    hideDuringEvent: 0
    condition:
      day: 0
      night: 0
      requiredFlag: 
      flagValue: 1
      choiceSource: 
      choiceEntry: 
      choiceReply: 
    choices: []
  - speaker: TheTruth
    text: Although...
    charactersPerSecond: -1
    eventId: 
    eventAfterLine: 1
    pauseForAnimation: 0
    hideDuringEvent: 0
    condition:
      day: 0
      night: 0
      requiredFlag: 
      flagValue: 1
      choiceSource: 
      choiceEntry: 
      choiceReply: 
    choices: []
  - speaker: TheTruth
    text: Would it really be so terrible to rest?
    charactersPerSecond: -1
    eventId: 
    eventAfterLine: 1
    pauseForAnimation: 0
    hideDuringEvent: 0
    condition:
      day: 0
      night: 0
      requiredFlag: 
      flagValue: 1
      choiceSource: 
      choiceEntry: 
      choiceReply: 
    choices: []
