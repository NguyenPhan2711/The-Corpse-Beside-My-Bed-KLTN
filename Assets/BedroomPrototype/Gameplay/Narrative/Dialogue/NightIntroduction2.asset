      day: 0
      night: 0
      requiredFlag: 
      flagValue: 1
      choiceSource: 
      choiceEntry: 
      choiceReply: 
    choices: []
  - speaker: TheTruth
    text: It just means you won't hear it coming next time.
    localizedText:
      m_TableReference:
        m_TableCollectionName: GUID:307a777c1a3e2004bbee95f62ad7e4f4
      m_TableEntryReference:
        m_KeyId: 2054312898568
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
