      choiceReply: 
    choices: []
  - speaker: TheTruth
    text: And about that window...
    localizedText:
      m_TableReference:
        m_TableCollectionName: GUID:307a777c1a3e2004bbee95f62ad7e4f4
      m_TableEntryReference:
        m_KeyId: 2054312898566
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    charactersPerSecond: -1
