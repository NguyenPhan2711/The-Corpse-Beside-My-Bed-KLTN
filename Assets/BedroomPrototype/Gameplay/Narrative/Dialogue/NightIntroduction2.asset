      requiredFlag: 
      flagValue: 1
      choiceSource: 
      choiceEntry: 
      choiceReply: 
    choices: []
  - speaker: TheTruth
    text: Strange how comfortable you've gotten with things that hurt you.
    localizedText:
      m_TableReference:
        m_TableCollectionName: GUID:307a777c1a3e2004bbee95f62ad7e4f4
      m_TableEntryReference:
