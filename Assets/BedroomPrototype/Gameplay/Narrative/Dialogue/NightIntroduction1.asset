  m_Script: {fileID: 11500000, guid: d43b58dd5625d7e4489ca099088080bb, type: 3}
  m_Name: NightIntroduction1
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  sequenceId: truth-night-1
  blockMovement: 1
  allowLook: 1
  lines:
  - speaker: TheTruth
    text: Can't sleep?
    localizedText:
      m_TableReference:
        m_TableCollectionName: GUID:307a777c1a3e2004bbee95f62ad7e4f4
      m_TableEntryReference:
        m_KeyId: 2054229012480
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    charactersPerSecond: -1
    eventId: 
    eventAfterLine: 1
    pauseForAnimation: 0
    hideDuringEvent: 0
    condition:
      day: 0
      night: 0
      requiredFlag: 
      flagValue: 1
      choiceSource: 
      choiceEntry: 
      choiceReply: 
    choices: []
  - speaker: TheTruth
    text: Of course you can't.
    localizedText:
      m_TableReference:
        m_TableCollectionName: GUID:307a777c1a3e2004bbee95f62ad7e4f4
      m_TableEntryReference:
        m_KeyId: 2054308704256
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    charactersPerSecond: -1
    eventId: 
    eventAfterLine: 1
    pauseForAnimation: 0
    hideDuringEvent: 0
    condition:
      day: 0
      night: 0
      requiredFlag: 
      flagValue: 1
      choiceSource: 
      choiceEntry: 
      choiceReply: 
    choices: []
  - speaker: TheTruth
    text: Well, since we're both awake, I might as well tell you something.
    localizedText:
      m_TableReference:
        m_TableCollectionName: GUID:307a777c1a3e2004bbee95f62ad7e4f4
      m_TableEntryReference:
        m_KeyId: 2054308704257
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    charactersPerSecond: -1
    eventId: 
    eventAfterLine: 1
    pauseForAnimation: 0
    hideDuringEvent: 0
    condition:
      day: 0
      night: 0
      requiredFlag: 
      flagValue: 1
      choiceSource: 
      choiceEntry: 
      choiceReply: 
    choices: []
  - speaker: TheTruth
    text: If you hear scratching beneath the bed, don't hide immediately.
    localizedText:
      m_TableReference:
        m_TableCollectionName: GUID:307a777c1a3e2004bbee95f62ad7e4f4
      m_TableEntryReference:
        m_KeyId: 2054308704258
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    charactersPerSecond: -1
    eventId: 
    eventAfterLine: 1
    pauseForAnimation: 0
    hideDuringEvent: 0
    condition:
      day: 0
      night: 0
      requiredFlag: 
      flagValue: 1
      choiceSource: 
      choiceEntry: 
      choiceReply: 
    choices: []
  - speaker: TheTruth
    text: Wait until whatever's under there shows itself.
    localizedText:
      m_TableReference:
        m_TableCollectionName: GUID:307a777c1a3e2004bbee95f62ad7e4f4
      m_TableEntryReference:
        m_KeyId: 2054308704259
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    charactersPerSecond: -1
    eventId: 
    eventAfterLine: 1
    pauseForAnimation: 0
    hideDuringEvent: 0
    condition:
      day: 0
      night: 0
      requiredFlag: 
      flagValue: 1
      choiceSource: 
      choiceEntry: 
      choiceReply: 
    choices: []
  - speaker: TheTruth
    text: Then pull that blanket over your head.
    localizedText:
      m_TableReference:
        m_TableCollectionName: GUID:307a777c1a3e2004bbee95f62ad7e4f4
      m_TableEntryReference:
        m_KeyId: 2054308704260
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    charactersPerSecond: -1
    eventId: 
    eventAfterLine: 1
    pauseForAnimation: 0
    hideDuringEvent: 0
    condition:
      day: 0
      night: 0
      requiredFlag: 
      flagValue: 1
      choiceSource: 
      choiceEntry: 
      choiceReply: 
    choices: []
  - speaker: TheTruth
    text: And if someone comes knocking at the door...
    localizedText:
      m_TableReference:
        m_TableCollectionName: GUID:307a777c1a3e2004bbee95f62ad7e4f4
      m_TableEntryReference:
        m_KeyId: 2054308704261
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    charactersPerSecond: -1
    eventId: 
    eventAfterLine: 1
    pauseForAnimation: 0
    hideDuringEvent: 0
    condition:
      day: 0
      night: 0
      requiredFlag: 
      flagValue: 1
      choiceSource: 
      choiceEntry: 
      choiceReply: 
    choices: []
  - speaker: TheTruth
    text: Don't make a sound when it opens.
    localizedText:
      m_TableReference:
        m_TableCollectionName: GUID:307a777c1a3e2004bbee95f62ad7e4f4
      m_TableEntryReference:
        m_KeyId: 2054308704262
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    charactersPerSecond: -1
    eventId: 
    eventAfterLine: 1
    pauseForAnimation: 0
    hideDuringEvent: 0
    condition:
      day: 0
      night: 0
      requiredFlag: 
      flagValue: 1
      choiceSource: 
      choiceEntry: 
      choiceReply: 
    choices: []
  - speaker: TheTruth
    text: Just hold your breath.
    localizedText:
      m_TableReference:
        m_TableCollectionName: GUID:307a777c1a3e2004bbee95f62ad7e4f4
      m_TableEntryReference:
        m_KeyId: 2054308704263
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    charactersPerSecond: -1
    eventId: 
    eventAfterLine: 1
    pauseForAnimation: 0
    hideDuringEvent: 0
    condition:
      day: 0
      night: 0
      requiredFlag: 
      flagValue: 1
      choiceSource: 
      choiceEntry: 
      choiceReply: 
    choices: []
  - speaker: TheTruth
    text: Oh, and keep that flashlight nearby.
    localizedText:
      m_TableReference:
        m_TableCollectionName: GUID:307a777c1a3e2004bbee95f62ad7e4f4
      m_TableEntryReference:
        m_KeyId: 2054308704264
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    charactersPerSecond: -1
    eventId: 
    eventAfterLine: 1
    pauseForAnimation: 0
    hideDuringEvent: 0
    condition:
      day: 0
      night: 0
      requiredFlag: 
      flagValue: 1
      choiceSource: 
      choiceEntry: 
      choiceReply: 
    choices: []
  - speaker: TheTruth
    text: Something likes looking through your window.
    localizedText:
      m_TableReference:
        m_TableCollectionName: GUID:307a777c1a3e2004bbee95f62ad7e4f4
      m_TableEntryReference:
        m_KeyId: 2054308704265
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    charactersPerSecond: -1
    eventId: 
    eventAfterLine: 1
    pauseForAnimation: 0
    hideDuringEvent: 0
    condition:
      day: 0
      night: 0
      requiredFlag: 
      flagValue: 1
      choiceSource: 
      choiceEntry: 
      choiceReply: 
    choices: []
  - speaker: TheTruth
    text: Shine it in the face if it gets too close.
    localizedText:
      m_TableReference:
        m_TableCollectionName: GUID:307a777c1a3e2004bbee95f62ad7e4f4
      m_TableEntryReference:
        m_KeyId: 2054308704266
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    charactersPerSecond: -1
    eventId: 
    eventAfterLine: 1
    pauseForAnimation: 0
    hideDuringEvent: 0
    condition:
      day: 0
      night: 0
      requiredFlag: 
      flagValue: 1
      choiceSource: 
      choiceEntry: 
      choiceReply: 
    choices: []
  - speaker: TheTruth
    text: And if it leaves the window open, you might want to close it.
    localizedText:
      m_TableReference:
        m_TableCollectionName: GUID:307a777c1a3e2004bbee95f62ad7e4f4
      m_TableEntryReference:
        m_KeyId: 2054308704267
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    charactersPerSecond: -1
    eventId: 
    eventAfterLine: 1
    pauseForAnimation: 0
    hideDuringEvent: 0
    condition:
      day: 0
      night: 0
      requiredFlag: 
      flagValue: 1
      choiceSource: 
      choiceEntry: 
      choiceReply: 
    choices: []
  - speaker: TheTruth
    text: Unless you enjoy being surprised.
    localizedText:
      m_TableReference:
        m_TableCollectionName: GUID:307a777c1a3e2004bbee95f62ad7e4f4
      m_TableEntryReference:
        m_KeyId: 2054308704268
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    charactersPerSecond: -1
    eventId: 
    eventAfterLine: 1
    pauseForAnimation: 0
    hideDuringEvent: 0
    condition:
      day: 0
      night: 0
      requiredFlag: 
      flagValue: 1
      choiceSource: 
      choiceEntry: 
      choiceReply: 
    choices: []
  - speaker: TheTruth
    text: Funny, isn't it?
    localizedText:
      m_TableReference:
        m_TableCollectionName: GUID:307a777c1a3e2004bbee95f62ad7e4f4
      m_TableEntryReference:
        m_KeyId: 2054308704269
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    charactersPerSecond: -1
    eventId: 
    eventAfterLine: 1
    pauseForAnimation: 0
    hideDuringEvent: 0
    condition:
      day: 0
      night: 0
      requiredFlag: 
      flagValue: 1
      choiceSource: 
      choiceEntry: 
      choiceReply: 
    choices: []
  - speaker: TheTruth
    text: All these things trying to get to you.
    localizedText:
      m_TableReference:
        m_TableCollectionName: GUID:307a777c1a3e2004bbee95f62ad7e4f4
      m_TableEntryReference:
        m_KeyId: 2054308704270
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    charactersPerSecond: -1
    eventId: 
    eventAfterLine: 1
    pauseForAnimation: 0
    hideDuringEvent: 0
    condition:
      day: 0
      night: 0
      requiredFlag: 
      flagValue: 1
      choiceSource: 
      choiceEntry: 
      choiceReply: 
    choices: []
  - speaker: TheTruth
    text: And you're still the one who has to keep yourself alive.
    localizedText:
      m_TableReference:
        m_TableCollectionName: GUID:307a777c1a3e2004bbee95f62ad7e4f4
      m_TableEntryReference:
        m_KeyId: 2054308704271
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    charactersPerSecond: -1
    eventId: 
    eventAfterLine: 1
    pauseForAnimation: 0
    hideDuringEvent: 0
